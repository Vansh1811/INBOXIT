# ─── Core server ─────────────────────────────────────────────────────────────
PORT = 5000
NODE_ENV = development

# MongoDB (Atlas)
MONGO_URI = mongodb+srv://<user>:<password>@<cluster-host>/<dbname>

# Google OAuth2 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID = your_google_client_id
GOOGLE_CLIENT_SECRET = your_google_client_secret
# Must exactly match one of the Authorized redirect URIs on the OAuth client:
GOOGLE_REDIRECT_URI = http://localhost:5000/auth/google/callback

# JWT signing secret for app sessions (generate: openssl rand -hex 32)
JWT_SECRET = your_jwt_secret

# Frontend URL — also used as the default allowed CORS/socket origin.
CLIENT_URL = http://localhost:3000
# Optional: extra comma-separated origins, e.g. "https://app.example.com"
CORS_ORIGIN =

# ─── Cookie auth ─────────────────────────────────────────────────────────────
# Set ONLY when frontend and API are sibling subdomains of a shared root
# domain (e.g. ".inboxit.in" for app.inboxit.in + api.inboxit.in).
# Leave empty for localhost / different-site deployments.
COOKIE_DOMAIN =

# ─── Token encryption at rest (REQUIRED) ─────────────────────────────────────
# AES-256-GCM key for encrypting Gmail OAuth tokens in MongoDB. 64 hex chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: losing this key makes stored refresh tokens undecryptable —
# users would just need to re-login. Never commit the real value.
TOKEN_ENCRYPTION_KEY = generate_with_command_above

# ─── Redis (Upstash) — cache + BullMQ queues ─────────────────────────────────
REDIS_HOST = redis_host
REDIS_PORT = 6379
REDIS_PASSWORD = redis_password
REDIS_USERNAME = default
REDIS_URL = rediss://default:redis_password@redis_host:6379

# ─── Gmail Pub/Sub push webhook (optional) ───────────────────────────────────
# Audience string configured on your Pub/Sub push subscription's OIDC auth.
# While unset, /webhooks/gmail rejects ALL pushes (fails closed) and the app
# falls back to its 60s polling sync.
PUBSUB_OIDC_AUDIENCE =
